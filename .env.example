# Canonical URL — used for metadata, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://rafsanraiyan.com

# Contact form delivery (optional).
# Without these the form falls back to opening the visitor's mail client,
# so it still works — it just doesn't send server-side.
# Get a key at https://resend.com
RESEND_API_KEY=
# Must be a domain you've verified in Resend, e.g. hello@rafsanraiyan.com
CONTACT_FROM_EMAIL=
