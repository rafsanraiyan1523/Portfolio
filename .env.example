# Canonical URL — used for metadata, sitemap, OG tags, and as the site the
# contact form identifies itself as.
NEXT_PUBLIC_SITE_URL=https://rafsanraiyan.com

# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# Enquiries go to CONTACT_TO_EMAIL (defaults to the email in src/lib/data.ts).
# The form tries these channels in order and uses the first that works:
#
#   1. Gmail SMTP  — set GMAIL_USER and GMAIL_APP_PASSWORD. Most reliable.
#                    Create the app password at https://myaccount.google.com/apppasswords
#                    (needs 2-Step Verification on the Google account).
#   2. Resend      — set RESEND_API_KEY (https://resend.com). Without a verified
#                    domain it sends from onboarding@resend.dev, which can only
#                    deliver to the email the Resend account was created with.
#   3. FormSubmit  — no setup. The first message sends a one-time "Activate
#                    Form" email to the inbox; click it and every message after
#                    that is delivered.
#
# None are required; with nothing set, FormSubmit is used.

CONTACT_TO_EMAIL=

GMAIL_USER=
GMAIL_APP_PASSWORD=

RESEND_API_KEY=
# Optional sender for Resend, e.g. "Portfolio <hello@rafsanraiyan.com>" once that domain is verified.
CONTACT_FROM_EMAIL=
